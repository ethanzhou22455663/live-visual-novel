# ============================================================
# 复制为 .env 并填入你自己的值。.env 已被 .gitignore 排除,永不入库。
# ============================================================

# DeepSeek API key(https://platform.deepseek.com 申请;只存本地,经 dev proxy 注入)
DEEPSEEK_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# GPT-SoVITS 参考音频(服务端进程本机可读的绝对路径;红线:仅自录/授权音源)
VITE_TTS_REF_PATH=D:/path/to/your/ref.wav

# 参考音频转写文本(可选但推荐:录音里说的原话,日文/中文皆可)
VITE_TTS_PROMPT_TEXT=

# 火山方舟(Seedream 生图),https://console.volcengine.com/ark
ARK_KEY=
